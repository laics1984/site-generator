# Webtree AI server config — copy to ai-server/.env and edit.
#
# This file is the single source of truth for WHICH model runs and HOW. The
# site-generator backend holds only LLM_BASE_URL; it reads the model id from
# /v1/models at runtime, so changing the model here needs no backend edit and
# no backend restart.

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
# ollama    — default. Model swapping by registry tag, auto load/unload.
# llamacpp  — manual control of the GPU/CPU split (--n-cpu-moe) and sampling
#             flags. Models are HuggingFace GGUF specs, not short tags, and
#             quant naming differs per publisher. NB Ollama >=0.32 already does
#             automatic sub-layer MoE overflow, so this is a tuning lever, not
#             a guaranteed speedup — measure before switching.
# mlx       — Apple Silicon only; runs host-native via mlx_lm.server (no container
#             exists — Metal can't be virtualized). ai.sh manages the process.
# external  — a remote AI box, Windows-native Ollama, or LM Studio. ai.sh starts
#             nothing and only health-checks the endpoint.
LLM_ENGINE=ollama

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Ollama tag (LLM_ENGINE=ollama) or MLX repo id (LLM_ENGINE=mlx).
# qwen3.6:35b-a3b — MoE, 35B total but only 3B active per token, ~24GB at Q4_K_M.
# NOTE the two suffixes describe different things: `a3b` is the ARCHITECTURE
# (3B active), `q4_K_M` is the QUANTIZATION. The bare tag already resolves to
# Q4_K_M, so `35b-a3b` and `35b-a3b-q4_K_M` are the same 24GB download.
LLM_MODEL=qwen3.6:35b-a3b

# Swap table — change ONE line above (or LLM_HF_REPO below for llamacpp):
#
#   Model                 LLM_ENGINE=ollama              LLM_ENGINE=llamacpp (LLM_HF_REPO)
#   Qwen3.6 35B-A3B       qwen3.6:35b-a3b                unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M
#   Qwen3.6 35B nvfp4     qwen3.6:35b-a3b-nvfp4          (native FP4 — Blackwell only, ~22GB)
#   Qwen3.6 35B MTP       qwen3.6:35b-a3b-mtp-q4_K_M     unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_M
#   DeepSeek              deepseek-r1:32b                 unsloth/DeepSeek-R1-Distill-Qwen-32B-GGUF:Q4_K_M
#   GLM                   glm-z1:9b                       (small — good reasoning-role companion)
#   Kimi                  kimi-k2:latest                  (very large — check it fits before pulling)
#
# Verify an Ollama tag exists: https://ollama.com/library/<name>/tags
# Verify a GGUF quant tag exists in that repo's file list on HuggingFace — quant
# NAMING DIFFERS PER PUBLISHER (unsloth ships UD-Q4_K_M, bartowski ships Q4_K_M),
# and a wrong -hf spec makes llama-server exit at startup.
#
# CAVEAT (ollama engine only): Ollama advertises EVERY pulled model on
# /v1/models, and the backend discovers its model from that list — picking the
# alphabetically first when there are several. With more than one model pulled,
# this line alone is therefore not authoritative. `./ai.sh up` warns when that
# applies; `ollama rm` the ones you don't want, or pin LLM_MODEL in the
# site-generator .env. llamacpp and mlx serve one model each, so it can't arise.
# Sizing rule for this box (16GB VRAM / 24GB WSL RAM): anything over ~15GB spills
# experts to system RAM. That is fine for an MoE with few active params, and slow
# for a DENSE model of the same size — prefer MoE (`-a3b`-style) tags.
#
# After a swap, re-check the backend's batching caps (MAX_SECTIONS_PER_BATCH,
# MAX_PAGES_PER_BATCH, BRAND_DETECTION_MAX_CHARS in the root .env): they are tuned
# against the model's context and capability, and are NOT auto-derived.

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# Context window. Must cover the LARGEST backend call (scaffolded content
# batches) — the OpenAI wire has no per-request num_ctx, so this one value
# applies to every call. Raise it if generation truncates; lower it to free VRAM.
LLM_CTX=16384

# How long Ollama keeps the model resident after a request. The backend fires
# brand detection, then generation after the user picks pages; a cold reload of
# ~24GB in between would blow its read timeout.
LLM_KEEP_ALIVE=30m

OLLAMA_PORT=11434
LLAMACPP_PORT=8080

# ---------------------------------------------------------------------------
# llama.cpp only
# ---------------------------------------------------------------------------
# Unsloth uses UD- (Unsloth Dynamic) quant names — a plain Q4_K_M tag does
# NOT exist there and llama-server fails at startup. Sizes for this repo:
#   UD-IQ4_XS  17.7GB  ~3GB spill on a 16GB card — fastest usable
#   UD-Q4_K_M  22.1GB  ~7GB spill — closest match to the Ollama default
#   UD-Q3_K_XL 16.8GB  nearly fits VRAM outright, lower quality
LLM_HF_REPO=unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M
# Stable id exposed on /v1/models. The backend auto-discovers it, so this only
# needs to be readable, not memorized.
LLM_ALIAS=qwen3.6-35b-a3b
# THE performance knob. Keeps MoE expert tensors of the first N layers in CPU RAM
# while attention + KV cache stay on the GPU. Lower N = more on GPU = faster,
# until you OOM. See README §C for the tuning loop.
LLM_N_CPU_MOE=14
# Escape hatch for extra llama-server flags, e.g. --api-key <secret> to require
# auth (then set the same value as LLM_API_KEY in the site-generator .env).
LLAMACPP_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Tailscale (remote access)
# ---------------------------------------------------------------------------
# 1 ⇒ ai.sh layers docker-compose.tailscale.yml, joining the engine to a
# tailnet-connected sidecar. The server becomes http://<TS_HOSTNAME>:11434 from
# any tailnet device, with no firewall rule. Localhost access still works.
TAILSCALE_ENABLED=0
# Reusable key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=webtree-ai
# e.g. --advertise-tags=tag:ai so a Tailscale ACL can restrict who reaches it.
# This is the real access control under Ollama, which has no API-key support.
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# MLX only (Apple Silicon host)
# ---------------------------------------------------------------------------
# Where ai.sh looks for mlx_lm.server. Install: python3 -m venv ~/mlx-venv &&
# ~/mlx-venv/bin/pip install mlx-lm
MLX_VENV=~/mlx-venv
MLX_PORT=8080

# ---------------------------------------------------------------------------
# external only
# ---------------------------------------------------------------------------
# The endpoint ai.sh health-checks (server root, no /v1 suffix).
EXTERNAL_BASE_URL=http://100.x.y.z:8080
